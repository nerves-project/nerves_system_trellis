+
+# * `CPPFLAGS' - C pre-processor flags.
+CPPFLAGS="--sysroot=$ARM_SYSROOT"
+
+# * `CXX' - C++ compiler.
+CXX="arm-linux-gnueabihf-g++ -march=armv7-a -marm -mfpu=neon --sysroot=$ARM_SYSROOT"
+
+# * `CXXFLAGS' - C++ compiler flags.

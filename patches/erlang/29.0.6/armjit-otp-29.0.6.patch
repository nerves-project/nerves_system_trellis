-                 micro_seconds -> 1000*1000;
-                 milli_seconds -> 1000;
-                 seconds -> 1;
-
-                 _ when ToUnit > 0 -> ToUnit
-             end,
-        case Time < 0 of
-            true -> TU*Time - (FU - 1);
-            false -> TU*Time
-        end div FU
-    catch
-        _ : _ ->
-            error(badarg, [Time, FromUnit, ToUnit])
-    end.

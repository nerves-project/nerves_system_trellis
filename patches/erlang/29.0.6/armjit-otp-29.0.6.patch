+                a64::Gp bin_data = ARG8;
+
+                update_bin_state(bin_offset,
+                                 bit_offset,
+                                 seg.effectiveSize,
+                                 a64::Gp());
+
+                if (!is_byte_aligned) {
+                    if (bit_offset < 0) {
+                        /* Bit offset is unknown. Must test alignment. */
+                        a.ands(bin_offset, bin_offset, imm(7));
+                        a.b_eq(store);

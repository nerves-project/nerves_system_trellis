+//! \{
+
+class EmitHelper : public BaseEmitHelper {
+public:
+  ASMJIT_INLINE_NODEBUG explicit EmitHelper(BaseEmitter* emitter = nullptr) noexcept
+    : BaseEmitHelper(emitter) {}
+
+  ASMJIT_INLINE_NODEBUG ~EmitHelper() noexcept override = default;

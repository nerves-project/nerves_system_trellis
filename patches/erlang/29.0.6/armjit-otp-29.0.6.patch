+# -Wshift-count-overflow <- 100% DANGEROUS and needs a fix
+# -Wincompatible-pointer-types <- maybe harmless
+# -Wuninitialized <- due to lack of implementation
+# -Wignored-attributes <- due to lack of implementation
+# Skipping warinings that are considered neglegible

From: Luca Succi <luca.succi@stritzinger.com>
Date: Mon, 9 Dec 2024 16:08:55 +0100
Subject: [PATCH 004/364] Enable configure to build arm32-jit on linux target
 OS

---
 erts/configure.ac | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/erts/configure.ac b/erts/configure.ac
index b5774f25b1..ffd59f4545 100644
--- a/erts/configure.ac
+++ b/erts/configure.ac
@@ -3100,6 +3100,21 @@ AS_IF([test ${enable_jit} != no],
               ;;
            esac
            ;;
+        arm)
+           case "$OPSYS" in
+              linux)
+                # These platforms have dedicated system calls for clearing
+                # instruction cache, and don't require us to manually issue
+                # instruction barriers on all threads.
+                JIT_ARCH=arm
+                JIT_ARCH_BITS=32
+              ;;
+              *)
+                enable_jit=no
+                AC_MSG_WARN([JIT disabled due to lack of cache-clearing instructions])
+              ;;
+           esac
+           ;;
         *)
            if test ${enable_jit} = yes; then
              AC_MSG_ERROR([JIT only works on x86 64-bit and ARM 64-bit])

+    auto element = load_source(Element, TMP2);
+    a64::Gp boxed_ptr = emit_ptr_val(TMP1, tuple.reg);
+    arm::Mem boxed_val = emit_boxed_val(boxed_ptr, Offset.get());
+
+    stur(element.reg, boxed_val);
+}

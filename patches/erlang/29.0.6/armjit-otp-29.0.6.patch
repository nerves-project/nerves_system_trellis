-                 micro_seconds -> 1000*1000;
-                 milli_seconds -> 1000;
-                 seconds -> 1;
-
-                 _ when FromUnit > 0 -> FromUnit
-             end,
-        TU = case ToUnit of
-                 native -> erts_internal:time_unit();
-                 perf_counter -> erts_internal:perf_counter_unit();
-                 nanosecond -> 1000*1000*1000;
-                 microsecond -> 1000*1000;
-                 millisecond -> 1000;

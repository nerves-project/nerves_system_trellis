+    a.add(TMP2, TMP2, imm(7));
+    a.lsl(TMP2, TMP2, imm(_TAG_IMMED1_SIZE - 3));
+    a.orr(ARG1, TMP2, imm(_TAG_IMMED1_SMALL));
+
+    a.ret(a64::x30);

+void BeamModuleAssembler::emit_bs_get_tail(const ArgRegister &Ctx,
+                                           const ArgRegister &Dst,
+                                           const ArgWord &Live) {
+    mov_arg(ARG1, Ctx);
+
+    emit_gc_test_preserve(ArgWord(BUILD_SUB_BITSTRING_HEAP_NEED),
+                          Live,
+                          Ctx,
+                          ARG1);
+
+    fragment_call(ga->get_bs_get_tail_shared());
+
+    mov_arg(Dst, ARG1);
+}

+    // start_time precedes start_time_i in the struct
+    const Uint relative_start_t_offset = start_t_offset - start_t_i_offset;
+    a.mov(ARG4, scheduler_registers);
+    a.add(ARG4, ARG4, imm(start_t_i_offset));
